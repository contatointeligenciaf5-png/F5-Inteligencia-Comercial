# === Notion ===
# Crie uma integração interna em https://www.notion.so/my-integrations, compartilhe
# as páginas Dashboard Geral, Sergipe - SE e Bahia - BA com ela (ela precisa "ver"
# a página e todo mundo dentro) e cole o token aqui. É a ÚNICA variável obrigatória —
# os IDs das data sources já estão hardcoded em src/lib/notion/client.ts (não são
# segredo, são identificadores estáveis do schema).
NOTION_API_KEY=

# Override opcional dos IDs de data source (só preencha se a base mudar de lugar
# no Notion ou se você quiser apontar para um workspace de teste). Ver
# src/lib/notion/client.ts para a lista completa e os valores-padrão.
# NOTION_DS_PIPELINE_GERAL=
# NOTION_DS_COMISSOES=
# NOTION_DS_FINANCEIRO_GERAL=
# NOTION_DS_INSIGHTS=
# NOTION_DS_PIPELINE_SE=
# NOTION_DS_SCRIPTS_SE=
# NOTION_DS_PROSPECCOES_SE=
# NOTION_DS_PROFISSIONAIS_SE=
# NOTION_DS_RODIZIO_SE=
# NOTION_DS_PIPELINE_BA=
# NOTION_DS_SCRIPTS_BA=
# NOTION_DS_PROSPECCOES_BA=
# NOTION_DS_PROFISSIONAIS_BA=   # obrigatório hoje — ID ainda não confirmado (ver CLAUDE.md)
# NOTION_DS_RODIZIO_BA=         # obrigatório hoje — ID ainda não confirmado (ver CLAUDE.md)

# === Auth (gate simples de acesso interno) ===
AUTH_PASSWORD=            # senha de acesso ao Portal
AUTH_SECRET=              # string aleatória longa, ex: `openssl rand -hex 32`
