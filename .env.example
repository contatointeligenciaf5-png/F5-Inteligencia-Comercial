# === Notion ===
# Crie uma integração interna em https://www.notion.so/my-integrations,
# compartilhe as páginas/bases relevantes com ela e cole o token aqui.
NOTION_API_KEY=

# IDs das data sources (não confundir com o ID da página/database "container").
# Para pegar o ID: abra a base no Notion, "Copiar link" e extraia o UUID da URL,
# ou use o campo `data-source-url` retornado pela API/MCP do Notion.
NOTION_DS_PIPELINE=       # base "Controle Geral" (leads/pipeline)
NOTION_DS_COMISSOES=      # base "Comissões por Empresa"
NOTION_DS_SCRIPTS=        # base "Central de Scripts"
NOTION_DS_INSIGHTS=       # base "Insights F5 / Inovação"

# === Auth (gate simples de acesso interno) ===
AUTH_PASSWORD=            # senha de acesso ao Portal
AUTH_SECRET=              # string aleatória longa, ex: `openssl rand -hex 32`
